+        ptr<__nv_bfloat16>(cs), ptr<__nv_bfloat16>(cw), ptr<float>(a_log), ptr<float>(dt_bias), (float)lower,
+        ptr<float>(q_out), ptr<float>(k_out), ptr<__nv_bfloat16>(v_out), ptr<float>(g_out), ptr<float>(b_out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_out_only_cuda(const at::Tensor& state_in, const at::Tensor& k, const at::Tensor& v, const at::Tensor& g,
+                       const at::Tensor& b, const at::Tensor& q_in, const at::Tensor& h_dev, int64_t rows,
+                       at::Tensor& y_out) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int H = (int)state_in.size(0);
+    out_only_kernel<<<H, 1024, 0, stream>>>(H, ptr<float>(state_in), ptr<float>(k), ptr<__nv_bfloat16>(v),
+                                            ptr<float>(g), ptr<float>(b), ptr<float>(q_in), ptr<int>(h_dev),
+                                            (int)rows, ptr<__nv_bfloat16>(y_out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// out_kernel alone: the gated RMSNorm epilogue, chain_wide's third stage for a read-out the delta rule did not
+// produce (out_only's y_out). H comes from the row width of out [rows, H * 128].
+void kda_out_norm_cuda(const at::Tensor& y_in, const at::Tensor& gate, int64_t g_stride, const at::Tensor& norm_w,
+                       double eps, at::Tensor& out) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const dim3 grid((unsigned)out.size(0), (unsigned)(out.size(1) / DV));
+    out_kernel<<<grid, DV, 0, stream>>>((int)(out.size(1) / DV), ptr<__nv_bfloat16>(y_in), ptr<__nv_bfloat16>(gate),
+                                        (int)g_stride, ptr<__nv_bfloat16>(norm_w), (float)eps,
+                                        ptr<__nv_bfloat16>(out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_out_only_seg_cuda(const at::Tensor& seg, const at::Tensor& rec, const at::Tensor& k, const at::Tensor& v,
+                           const at::Tensor& g, const at::Tensor& b, const at::Tensor& q_in,
+                           const at::Tensor& h_devs, at::Tensor& y_out) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int H = (int)rec.size(2), nseg = (int)seg.size(0);
+    out_only_seg_kernel<<<(unsigned)(nseg * H), 1024, 0, stream>>>(
+        H, ptr<int>(seg), ptr<float>(rec), (size_t)rec.stride(0), (size_t)rec.stride(1), ptr<float>(k),
+        ptr<__nv_bfloat16>(v), ptr<float>(g), ptr<float>(b), ptr<float>(q_in), ptr<int>(h_devs), (int)k.size(2),
+        ptr<__nv_bfloat16>(y_out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}

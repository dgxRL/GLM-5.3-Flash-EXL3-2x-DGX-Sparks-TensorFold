+def _replay_neutral(st: State, h: int) -> None:
+    """Rows h.. of the replay buffer neutral again (k = v = b = 0, g = 1: update's identity), so the flush's fixed
+    L-row replay reads exactly the committed rows 0..h-1 whatever older rounds left there."""
+

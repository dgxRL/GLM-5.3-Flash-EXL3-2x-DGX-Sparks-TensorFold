+"""Fused KDA chains and prefix replay use the same state update routine so a kept prefix preserves serial bits, and ``out_only`` reads a decode round's outputs from the checkpoint plus its buffer rows with those bits."""
 
 from __future__ import annotations
 
@@ -16,7 +16,7 @@

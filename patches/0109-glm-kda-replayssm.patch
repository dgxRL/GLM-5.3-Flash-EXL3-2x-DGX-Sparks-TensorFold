     L, H = scratch.layers, scratch.heads
     _ext().replay_layers_segments(seg, rec, scratch.k, scratch.v, scratch.g, scratch.b, scratch.rows * H * DK,
                                   scratch.rows * H, L, H)
+
+
+# -- checkpoint + replay buffer (ReplaySSM) --------------------------------------------------------------------
+# Decode rounds write their post-conv rows into a per-State buffer (the wide prep with buffer slices) and read
+# the outputs from the checkpoint plus the buffer (out_only): no state write, so a speculative rollback is a
+# buffer-pointer move and commit does not re-run replay_layers. When the buffer would overflow the window L, the
+# committed rows flush through replay (the exact bits of the serial steps) and the round's rows compact to the
+# front. Single-stream only in this patch.
+REPLAY_LEN = int(os.environ.get("TF_GLM_KDA_REPLAY_LEN", "0"))  # 0 = off; else the window L
+_rb: dict = {}
+
+
+def _replay_planes(layers: int, heads: int, cap: int, device) -> tuple:
+    """The buffer planes [layers, cap, heads, chan] and the int32[1] h mirror, cached per device so engine
+    startup's reserve and the State share one allocation (a captured graph keeps the addresses it captured)."""
+    device = torch.device(device)
+    if device.type == "cuda" and device.index is None:
+        device = torch.device("cuda", torch.cuda.current_device())
+    key = (layers, heads, cap, device)
+    planes = _rb.get(key)
+    if planes is None:
+        planes = (torch.empty((layers, cap, heads, DK), dtype=torch.float32, device=device),
+                  torch.empty((layers, cap, heads, DV), dtype=torch.bfloat16, device=device),
+                  torch.empty((layers, cap, heads, DK), dtype=torch.float32, device=device),
+                  torch.empty((layers, cap, heads), dtype=torch.float32, device=device),
+                  torch.zeros((1,), dtype=torch.int32, device=device))
+        _rb[key] = planes
+    return planes
+
+
+def replay_planes(layers: int, heads: int, cap: int, device) -> tuple:
+    """The cached buffer planes (k, v, g, b, h_dev) for a State's ``reset``/decode use; ``reserve_replay``
+    allocates them before any CUDA graph is captured."""
+
+    return _replay_planes(layers, heads, cap, device)
+
+
+def reserve_replay(layers: int, heads: int, cap: int, device) -> None:
+    """The replay buffer for ``cap`` rows per layer, allocated now (before graph capture)."""
+
+    _replay_planes(layers, heads, cap, device)
+
+
+def prep(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_state: torch.Tensor,
+         conv_w: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor, lower: float, rows: int,
+         k_out: torch.Tensor, v_out: torch.Tensor, g_out: torch.Tensor, b_out: torch.Tensor,
+         q_out: torch.Tensor) -> None:
+    """chain_wide's prep stage alone (the same conv + SiLU, decays, beta and q/k norms, the same bits) for rows
+    the delta rule does not run on yet: a decode round writes its post-conv rows into arbitrary per-layer buffer
+    slices -- k_out/g_out [rows, H, 128] fp32, v_out [rows, H, 128] bf16, b_out [rows, H] fp32 -- and the
+    normalized q into the wide scratch's q_tmp."""
+
+    _ext().prep(p, p.stride(0), int(b_off), a, a.stride(0), conv_state, conv_w, a_log, dt_bias, float(lower),
+                int(rows), q_out, k_out, v_out, g_out, b_out)
+
+
+def out_only(state_in: torch.Tensor, buf: tuple, q_in: torch.Tensor, h_dev: torch.Tensor, rows: int,
+             y_out: torch.Tensor) -> None:
+    """Decode outputs from the checkpoint + buffer with no state write: the bits of ``chain``'s rows h..h+rows-1
+    (the same ``update`` and read-out on the saved k/v/g/b, not a new summation order), so a non-flush round
+    changes nothing but the buffer. buf = (k, v, g, b) this layer's slices [cap, H, 128] / [cap, H]; q_in the
+    normalized q [rows, H, 128]; h_dev int32[1] the committed count (read on the device, graph-safe; the caller
+    keeps h + rows within the buffer's cap); y_out [rows, H * 128] the pre-norm read-out for ``out_kernel``."""
+
+    k, v, g, b = buf
+    _ext().out_only(state_in, k, v, g, b, q_in, h_dev, int(rows), y_out)
+
+
+def out_norm(y_in: torch.Tensor, gate: torch.Tensor, gate_stride: int, norm_w: torch.Tensor, eps: float,
+             out: torch.Tensor) -> None:
+    """out_kernel alone (the gated RMSNorm epilogue, chain_wide's third stage, its exact bits) for a read-out
+    the delta rule did not produce -- out_only's y_out: y_in [rows, H * 128] bf16 (e.g. the wide scratch's y
+    pair reshaped to 2-D), gate the bf16 gate rows (b.kg) with row stride ``gate_stride``, out [rows, H * 128]
+    bf16; H comes from the row width."""
+
+    _ext().out_norm(y_in, gate, int(gate_stride), norm_w, float(eps), out)
+
+
+def out_only_seg(seg: torch.Tensor, rec: torch.Tensor, buf: tuple, h_devs: torch.Tensor, q_in: torch.Tensor,
+                 y_out: torch.Tensor) -> None:
+    """``out_only`` for several streams' rows in one window (``segment_table``): segment i reads conversation
+    seg[i, SEG_SLOT] -- its rows in the pool planes buf = (k, v, g, b) [conversations, H, cap, chan] and its
+    committed count h_devs[slot] -- from rec[slot, parity] (read only) and writes its rows' read-out at the
+    stream's window rows row0 + the row within the buffer, like ``step_seg_kernel``'s y_out."""
+
+    k, v, g, b = buf
+    _ext().out_only_seg(seg, rec, k, v, g, b, q_in, h_devs, y_out)
